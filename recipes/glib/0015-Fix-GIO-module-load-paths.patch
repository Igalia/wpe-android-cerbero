From 7d226a4b9f363f24dfccc094b37b8b79138aaed0 Mon Sep 17 00:00:00 2001
From: Jani Hautakangas <jani@igalia.com>
Date: Tue, 13 Oct 2026 22:00:06 +0200
Subject: [PATCH] Fix GIO module load paths

Android app processes run with AT_SECURE=1 (inherited from zygote), which
g_check_setuid() reports as setuid, so GIO ignores GIO_MODULE_DIR and
GIO_EXTRA_MODULES. WPE-Android relies on GIO_EXTRA_MODULES to load the
TLS backend (glib-networking), so honour both variables.

Rebased onto glib 2.82.4 with cerbero's patches applied.
---
 gio/giomodule.c | 6 +-----
 1 file changed, 1 insertion(+), 5 deletions(-)

diff --git a/gio/giomodule.c b/gio/giomodule.c
index 7eb108b..b0895b4 100644
--- a/gio/giomodule.c
+++ b/gio/giomodule.c
@@ -1255,9 +1255,6 @@ get_gio_module_dir_env (void)
    *
    * If a setuid program somehow needs to load additional GIO modules, it should
    * explicitly call g_io_modules_scan_all_in_directory(). */
-  if (GLIB_PRIVATE_CALL (g_check_setuid) ())
-    return NULL;
-
   return g_strdup (g_getenv ("GIO_MODULE_DIR"));
 }
 
@@ -1324,13 +1321,12 @@ _g_io_modules_ensure_loaded (void)
 
   if (g_once_init_enter (&loaded_dirs))
     {
-      gboolean is_setuid = GLIB_PRIVATE_CALL (g_check_setuid) ();
       gchar *module_dir;
 
       scope = g_io_module_scope_new (G_IO_MODULE_SCOPE_BLOCK_DUPLICATES);
 
       /* First load any overrides, extras (but not if running as setuid!) */
-      module_path = !is_setuid ? g_getenv ("GIO_EXTRA_MODULES") : NULL;
+      module_path = g_getenv ("GIO_EXTRA_MODULES");
       if (module_path)
 	{
 	  gchar **paths;
-- 
