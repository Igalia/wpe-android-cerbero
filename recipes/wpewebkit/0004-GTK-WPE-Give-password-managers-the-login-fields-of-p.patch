+        g_clear_pointer(&test->m_submittedForm, webkit_login_form_unref);
+        test->m_submittedForm = webkit_login_form_ref(form);
+        if (test->m_waitingForSubmittedForm)
+            g_main_loop_quit(test->m_mainLoop);
+    }
+
+    void loadLoginForm()
